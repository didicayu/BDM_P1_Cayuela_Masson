\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}ML anomaly prediction}{4}{subsection.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces ML anomaly pipeline: \nolinkurl  {network_events} are vectorized into seven features, an Isolation Forest is fitted, and the same estimator scores every event. Anomalous rows are written to \nolinkurl  {anomaly_flags}, while the fitted model is persisted as auditable artifacts and a Delta metadata record.}}{5}{figure.15}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}IOC correlation coverage and data constraint}{5}{subsection.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces IOC correlation flow. Indicators from ThreatFox, URLhaus, and Shodan are indexed and exact-matched against network-event identifiers, producing \nolinkurl  {ioc_correlations} for Grafana. The dashed Shodan branch marks the external-API constraint (free \nolinkurl  {oss} plan, HTTP~403), which together with the IP-versus-domain mismatch yields no real matches on this corpus.}}{5}{figure.18}\protected@file@percent }
